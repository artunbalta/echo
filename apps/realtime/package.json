{
  "name": "@echo/realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:copresence": "ECHO_TRUST_CLIENT_ID=1 tsx src/copresence.test.mts",
    "test:race": "tsx src/observe-race.test.mts",
    "test:village": "tsx src/village.test.mts",
    "test:standin": "tsx src/standIn.test.mts",
    "test:watch": "tsx src/watch.test.mts",
    "test:shutdown": "tsx src/shutdown.test.mts",
    "test:talk": "tsx src/talk.test.mts"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.0",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.0",
    "@echo/planet": "*",
    "@echo/shared": "*",
    "colyseus": "^0.16.0",
    "dotenv": "^16.4.5",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
