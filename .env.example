# ─────────────────────────────────────────────────────────────────────────────
# ECHO environment configuration. Copy to `.env` (and `apps/web/.env.local`) and fill in.
# Nothing here is committed. Every provider is swappable; leave a key blank to use mocks.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Postgres + Auth + Storage + pgvector) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (for migrations / ML service / seed)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# ── Realtime (Colyseus) ──────────────────────────────────────────────────────
REALTIME_PORT=2567
NEXT_PUBLIC_REALTIME_URL=ws://localhost:2567

# ── ML service (Python FastAPI) ──────────────────────────────────────────────
ML_PORT=8000
ML_SERVICE_URL=http://localhost:8000
# Shared secret so only the realtime/web servers can call the ML service.
# THIS VALUE IS PUBLISHED — it is in this file, in git, and on GitHub. It is a local convenience and
# it is NOT a fallback: `services/ml` refuses every guarded request with 503 `ml_token_unconfigured`
# when ML_SERVICE_TOKEN is unset, rather than reaching for this literal, because behind that one
# token sit `GET /persona/{uid}` and `DELETE /user/{uid}` — the two capabilities ⚑27 closed one layer
# up. A local run gets it from `services/ml/_devlauncher.py` and `run.sh`; a deployment must set a
# real one. Same posture as ECHO_IDENTITY_SECRET below, arrived at from the other direction.
ML_SERVICE_TOKEN=dev-ml-token-change-me

# ── identity (SOC-2.E / C39) ───────────────────────────────────────────────────
# Signs the user id the browser carries, so a client can hold an identity but not CHOOSE one.
# Read by apps/web (every id-bearing route) and apps/realtime (the room join), which is why it is a
# shared secret rather than a Supabase JWT: the realtime server has no Supabase client and no anon key.
#
# UNSET IN PRODUCTION IS FAIL-CLOSED, not fail-open: minting answers 503 identity_unconfigured and
# every guarded route refuses. That is deliberate — a deployment that quietly accepted unsigned ids
# would look healthy while being exactly what this closes.
ECHO_IDENTITY_SECRET=dev-identity-secret-change-me
# The OUTGOING key during a rotation. verifyIdentity tries both, so a key can be replaced without
# orphaning every anonymous person at once — they hold the only copy of their identity and have
# nothing to re-present. Remove it once the window has passed.
# ECHO_IDENTITY_SECRET_OLD=

# Honours a client-asserted id (?u=, body userId) — FOR HARNESSES AND LOCAL WORK ONLY. It needs BOTH
# this flag set to the literal 1 AND a deployment that is not production; neither alone opens it.
# The harnesses compose their own ids (cap_tessa, f4sil…_twin) and ?u= is the only mechanism that
# yields two identities in one browser profile, which verify-3d-render.md depends on.
ECHO_TRUST_CLIENT_ID=1

# ── LLM (Anthropic Claude) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Strong model for sustained conversations + policy/reward judging; cheap model for ambient NPCs.
LLM_MODEL_STRONG=claude-opus-4-8
LLM_MODEL_CHEAP=claude-haiku-4-5-20251001
# The model villagers speak through on /api/village/talk (DECISIONS C42). Unset means claude-opus-5-5.
# Measured 2026-10-18: about $0.012 for a villager's first line (the cache write) and $0.004 after.
# claude-haiku-5-5 costs about a fortieth of that and has no refusal fallback; the choice is yours.
# VILLAGER_MODEL=claude-opus-5-5
# Where villagers' memories of strangers and the changes conversations make to their lives are kept
# (DECISIONS C44, db/migrations/0019_village_life.sql). Unset: Supabase, through the service role,
# which needs 0019 applied. `memory` keeps them in the server process and loses them on restart: for a
# machine whose database is behind, and for the tests. Never `memory` in production.
# VILLAGE_STORE=memory
# Embeddings provider for persona/behavior vectors (see services/ml/echo_ml/embeddings.py)
EMBEDDINGS_PROVIDER=mock          # mock | voyage | openai  (mock = zero-key deterministic)
EMBEDDINGS_API_KEY=
EMBEDDINGS_DIM=256
# Voyage AI (recommended): multilingual embeddings that fix the Turkish/English collapse.
# Set EMBEDDINGS_PROVIDER=voyage and a key below. voyage-3.5 is 256-d Matryoshka-native, so
# EMBEDDINGS_DIM=256 needs no projection. Alternatives: voyage-3-large (quality),
# voyage-3.5-lite (cost) — all multilingual. Requires `pip install voyageai` (optional;
# falls back to the REST API, then to the deterministic hash mock if unset).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5           # voyage-3.5 | voyage-3-large | voyage-3.5-lite

# ── TTS narrator ─────────────────────────────────────────────────────────────
TTS_PROVIDER=mock                 # mock | elevenlabs | openai
ELEVENLABS_API_KEY=               # also gives villagers voices of their own, and hears the stranger (C60)
ELEVENLABS_VOICE_ID=              # the narrator's voice only; villagers' come from the account's voice list
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2   # villagers' speech (C60)
# ELEVENLABS_STT_MODEL=scribe_v2                # writing down what the stranger says aloud (C60)
# Your own (cloned) voice, for your own identity only (C62): typed lines to villagers, later your echo.
# Both must be set; the subject is the id the mirror shows under "Your id here".
# ELEVENLABS_OWNER_VOICE_ID=
# ECHO_OWNER_SUBJECTS=                          # comma-separated echo subjects (UUIDs)
OPENAI_API_KEY=

# ── Character art generation ─────────────────────────────────────────────────
ART_PROVIDER=mock                 # mock | fal | higgsfield  (degrades to mock on failure)
# Fal (REST queue API, no SDK dep). Auth header is "Key $FAL_KEY".
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell     # override per your Fal catalog (img2img models also OK)
# Higgsfield (official @higgsfield/client SDK — opt-in: `npm i @higgsfield/client -w @echo/web`).
HF_API_KEY=
HF_SECRET=
# Canonical pixel-art style anchor (path or URL). See pipeline/assets/reference/.
ART_STYLE_REFERENCE=pipeline/assets/reference/style-anchor.png
# Supabase Storage bucket for generated sprite sheets (create a PUBLIC bucket named this).
# Without Supabase, sprites fall back to inline data URLs so the flow still works locally, so this
# is optional. Leave it unset and the code uses "characters".
# NOTE the NEXT_PUBLIC_ prefix, and do not remove it: the sprite upload happens in the BROWSER
# (lib/character.ts uploadSheet), and Next only exposes NEXT_PUBLIC_* to client code. This was
# previously documented as `ART_STORAGE_BUCKET`, which no code read and none could — an unprefixed
# name is invisible to the browser — while the bucket name sat hardcoded in lib/character.ts. If you
# set that and created a matching bucket, uploads still failed against "characters" with no hint.
NEXT_PUBLIC_ART_STORAGE_BUCKET=characters

# ── Cost controls ────────────────────────────────────────────────────────────
COST_DAILY_USD_BUDGET=25
COST_ALERT_WEBHOOK=

# ── THY brand-stand demo (/venue + /dashboard) ───────────────────────────────
# ALL optional. With none set the demo runs fully in mock mode (scripted salesperson,
# autonomous visitor sim, committed art, in-memory store). Adding a key flips that one
# subsystem to live — no code changes. (capabilities reads these at runtime.)
#   ANTHROPIC_API_KEY  → real LLM salesperson + visitor role-play     (shared with above)
#   HIGGSFIELD_API_KEY → `npm run gen:assets` generates venue art via the Higgsfield CLI
#   FAL_API_KEY        → Fal fallback art provider
#   TTS_API_KEY        → spoken salesperson (provider from TTS_PROVIDER above)
HIGGSFIELD_API_KEY=
FAL_API_KEY=
TTS_API_KEY=
# Optional model overrides for the salesperson / visitor sim:
LLM_MODEL_STRONG=claude-sonnet-4-6
LLM_MODEL_CHEAP=claude-haiku-4-5-20251001
