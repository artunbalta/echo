{
  "name": "echo",
  "version": "0.1.0",
  "private": true,
  "description": "ECHO \u2014 a persistent virtual world where your agent learns who you are.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @echo/shared && npm run build -w @echo/planet",
    "dev:web": "node scripts/check-env.mjs && npm run dev -w @echo/web",
    "dev:realtime": "npm run dev -w @echo/realtime",
    "dev:ml": "node scripts/check-env.mjs && bash services/ml/run.sh",
    "dev": "npm run build:shared && concurrently -n web,realtime -c cyan,magenta \"npm:dev:web\" \"npm:dev:realtime\"",
    "build": "npm run build:shared && npm run build -w @echo/realtime && npm run build -w @echo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "node db/seed/seed.mjs",
    "gen:assets": "node pipeline/generate-venue-assets.mjs",
    "gen:island-assets": "node pipeline/generate-island-assets.mjs",
    "gen:flow-assets": "node pipeline/generate-flow-assets.mjs",
    "gen:roster": "node pipeline/generate-roster-portraits.mjs",
    "verify:roster": "node pipeline/verify-roster.mjs",
    "gen:plates": "node pipeline/generate-legend-plates.mjs",
    "gen:vacancy": "node pipeline/derive-vacancy.mjs",
    "gen:palette": "node pipeline/derive-palette.mjs",
    "verify:pipeline": "node pipeline/verify-pipeline-parity.mjs",
    "demo": "node scripts/check-env.mjs && npm run build:shared && concurrently -n planet,web -c green,cyan \"npm run dev -w @echo/planet\" \"npm run dev -w @echo/web\"",
    "test:e2e": "npm run test:e2e -w @echo/web",
    "test:planet": "npm test -w @echo/planet",
    "test:web": "npm run build:shared && npm test -w @echo/web",
    "test:shared": "npm test -w @echo/shared",
    "check:env": "node scripts/check-env.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
